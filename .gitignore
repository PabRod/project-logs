# Obsidian configuration (whitelist approach)
.obsidian/*

!.obsidian/app.json
!.obsidian/core-plugins.json
!.obsidian/templates.json
!.obsidian/snippets/
!.obsidian/zk-prefixer.json
!.obsidian/types.json

# community-plugins.json is deliberately NOT whitelisted: this vault ships no
# community plugins, and the file rewrites itself whenever anyone enables a
# personal one. If a plugin is ever blessed, whitelist its code too:
#
# !.obsidian/plugins/ then .obsidian/plugins/* then !.obsidian/plugins/<name>/

# Personal configs (if any)
.obsidian-*/

# Housekeeping
.trash/
.DS_Store
.claude/
