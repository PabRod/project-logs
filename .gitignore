# Obsidian configuration (whitelist approach)
.obsidian/*

!.obsidian/app.json
!.obsidian/core-plugins.json
!.obsidian/templates.json
!.obsidian/snippets/
!.obsidian/zk-prefixer.json
!.obsidian/types.json

# Whitelists plug-ins one by one
!.obsidian/plugins/
.obsidian/plugins/*
# Explicitly whitelist here
!.obsidian/plugins/obsidian-tasks-plugin/

# Personal configs (if any)
.obsidian-*/

# Housekeeping
.trash/
.DS_Store
.claude/
